# Copiar a .env; completar localmente y no subirlo a Git.
RECOVERY_CODE_SECRET=
ADMIN_EMAIL=admin@induztek.ejemplo
ADMIN_PASSWORD=
ADMIN_SECURITY_ANSWER=
INTERNAL_EMAIL_DOMAIN=induztek.ejemplo
DB_USER=usuarios
DB_PASSWORD=
# Mailpit captura correos localmente, no los entrega a Internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@induztek.ejemplo
